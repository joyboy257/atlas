{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://schemas.usemirai.app/atlas/receipt/v1.json","title":"Atlas Receipt v1","type":"object","additionalProperties":false,"required":["apiVersion","kind","metadata","spec"],
  "properties":{"apiVersion":{"const":"atlas.mirai.dev/v1"},"kind":{"const":"Receipt"},"metadata":{"$ref":"#/$defs/metadata"},"spec":{"$ref":"#/$defs/spec"}},
