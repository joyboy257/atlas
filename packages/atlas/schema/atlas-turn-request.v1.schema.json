{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.usemirai.app/atlas/turn-request/v1.json",
  "title": "Atlas Turn Request v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocolVersion", "requestId", "traceId", "packageVersion", "tenant", "actor", "conversation", "channel", "messages", "knowledgeEvidence", "tools", "policyConstraints", "limits"],
  "properties": {
    "protocolVersion": { "const": "1" },
    "requestId": { "type": "string", "minLength": 1 },
    "traceId": { "type": "string", "minLength": 1 },
    "packageVersion": { "type": "string", "minLength": 1 },
    "tenant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "scopes"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "scopes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runtimeId", "runtimeType"],
      "properties": {
        "runtimeId": { "type": "string", "minLength": 1 },
        "runtimeType": { "enum": ["atlas-native", "openai-agents", "eve", "langgraph", "n8n", "custom"] }
      }
    },
    "customer": { "$ref": "#/$defs/scopedEntity" },
    "conversation": {
      "allOf": [
        { "$ref": "#/$defs/scopedEntity" },
        {
          "type": "object",
          "required": ["state"],
          "properties": {
            "state": { "enum": ["automated", "approval_pending", "human_handoff", "human_takeover", "completed"] },
            "threadId": { "type": "string", "minLength": 1 },
            "assignedOperatorId": { "type": "string", "minLength": 1 }
          }
        }
      ]
    },
    "channel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["channelId", "surfaces", "text", "media", "interactive", "reactions", "typing", "readReceipts", "edits", "deletes", "proactive"],
      "properties": {
        "channelId": { "type": "string", "minLength": 1 },
        "surfaces": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
        "text": { "type": "boolean" },
        "media": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
        "interactive": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
        "reactions": { "type": "boolean" },
        "typing": { "type": "boolean" },
        "readReceipts": { "type": "boolean" },
        "edits": { "type": "boolean" },
        "deletes": { "type": "boolean" },
        "proactive": {
          "type": "object",
          "additionalProperties": false,
          "required": ["supported", "consentRequired"],
          "properties": {
            "supported": { "type": "boolean" },
            "consentRequired": { "type": "boolean" },
            "templatePolicy": { "type": "string" },
            "windowPolicy": { "type": "string" }
          }
        }
      }
    },
    "messages": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/message" } },
    "knowledgeEvidence": { "type": "array", "items": { "$ref": "#/$defs/evidence" } },
    "tools": { "type": "array", "items": { "$ref": "#/$defs/tool" } },
    "policyConstraints": { "type": "array", "items": { "$ref": "#/$defs/policy" } },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["deadlineMs", "maxProposedActions"],
      "properties": {
        "deadlineMs": { "type": "integer", "minimum": 1, "maximum": 300000 },
        "maxOutputTokens": { "type": "integer", "minimum": 1 },
        "maxProposedActions": { "type": "integer", "minimum": 0, "maximum": 32 }
      }
    }
  },
  "$defs": {
    "scalar": { "type": ["string", "number", "boolean"] },
    "scopedEntity": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "displayName": { "type": "string" },
        "attributes": { "type": "object", "additionalProperties": { "$ref": "#/$defs/scalar" } }
      }
    },
    "message": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "direction", "role", "occurredAt"],
      "anyOf": [{ "required": ["text"] }, { "required": ["structured"] }],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "direction": { "enum": ["inbound", "outbound"] },
        "role": { "enum": ["customer", "operator", "agent", "system"] },
        "text": { "type": "string", "minLength": 1 },
        "structured": {},
        "occurredAt": { "type": "string", "format": "date-time" },
        "replyTo": { "type": "string" }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "source", "digest"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "minLength": 1 },
        "digest": { "type": "string", "minLength": 1 },
        "excerpt": { "type": "string" },
        "attributes": { "type": "object", "additionalProperties": { "$ref": "#/$defs/scalar" } }
      }
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "description", "risk", "execution", "approval", "idempotency"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "risk": { "enum": ["none", "low", "medium", "high", "critical"] },
        "execution": { "enum": ["read", "propose", "commit"] },
        "approval": { "enum": ["never", "conditional", "required"] },
        "idempotency": { "enum": ["not_applicable", "optional", "required"] },
        "inputSchema": { "type": "object" }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "effect", "description"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "effect": { "enum": ["allow", "deny", "require_approval", "require_handoff"] },
        "description": { "type": "string", "minLength": 1 },
        "appliesToTools": { "type": "array", "uniqueItems": true, "items": { "type": "string" } }
      }
    }
  }
}
