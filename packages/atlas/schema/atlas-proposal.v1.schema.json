{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://schemas.usemirai.app/atlas/proposal/v1.json",
  "title":"Atlas Proposal v1",
  "type":"object","additionalProperties":false,
  "required":["apiVersion","kind","metadata","spec"],
  "properties":{"apiVersion":{"const":"atlas.mirai.dev/v1"},"kind":{"const":"Proposal"},"metadata":{"$ref":"#/$defs/metadata"},"spec":{"$ref":"#/$defs/spec"}},
  "$defs":{
    "id":{"type":"string","minLength":1,"maxLength":2048,"pattern":"^[^\\u0000\\s][^\\u0000]*$"},
    "digest":{"type":"string","pattern":"^sha256:[a-f0-9]{64}$"},
    "metadata":{"type":"object","additionalProperties":false,"required":["id","schemaVersion"],"properties":{"id":{"$ref":"#/$defs/id"},"schemaVersion":{"const":"1"},"missionId":{"$ref":"#/$defs/id"}}},
    "scope":{"type":"object","additionalProperties":false,"required":["tenantId","organisationId","projectId","environmentId","missionId"],"properties":{"tenantId":{"$ref":"#/$defs/id"},"organisationId":{"$ref":"#/$defs/id"},"projectId":{"$ref":"#/$defs/id"},"environmentId":{"$ref":"#/$defs/id"},"missionId":{"$ref":"#/$defs/id"}}},
    "spec":{"type":"object","additionalProperties":false,"required":["scope","proposalType","agentVersionId","runtime","actor","stepId","intent","riskHint","provenance","createdAt"],"properties":{"scope":{"$ref":"#/$defs/scope"},"proposalType":{"enum":["message","action","wait","handoff","child-mission","completion"]},"agentVersionId":{"$ref":"#/$defs/digest"},"runtime":{"type":"object","additionalProperties":false,"required":["id","type","version"],"properties":{"id":{"$ref":"#/$defs/id"},"type":{"$ref":"#/$defs/id"},"version":{"$ref":"#/$defs/id"}}},"actor":{"type":"object","additionalProperties":false,"required":["type","identity"],"properties":{"type":{"enum":["system","developer","agent","operator","provider","scheduler","external-runtime"]},"identity":{"$ref":"#/$defs/id"}}},"stepId":{"$ref":"#/$defs/id"},"intent":{"type":"string","minLength":1,"maxLength":10000},"payload":{},"arguments":{},"contextRefs":{"type":"array","maxItems":256,"items":{"$ref":"#/$defs/id"}},"citations":{"type":"array","maxItems":256,"items":{"$ref":"#/$defs/id"}},"riskHint":{"enum":["none","low","medium","high","critical"]},"expectedOutcome":{"type":"string","maxLength":5000},"provenance":{"$ref":"#/$defs/provenance"},"createdAt":{"format":"date-time","type":"string"}}},
    "provenance":{"type":"object","additionalProperties":false,"required":["correlationId","causationId","sourceRef","inputDigest"],"properties":{"correlationId":{"$ref":"#/$defs/id"},"causationId":{"$ref":"#/$defs/id"},"sourceRef":{"$ref":"#/$defs/id"},"inputDigest":{"$ref":"#/$defs/digest"}}}
  }
}
