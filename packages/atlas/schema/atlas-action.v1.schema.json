  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://schemas.usemirai.app/atlas/action/v1.json","title":"Atlas Action v1","type":"object","additionalProperties":false,"required":["apiVersion","kind","metadata","spec"],
