{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://schemas.usemirai.app/atlas/decision/v1.json",
  "title":"Atlas Decision v1","type":"object","additionalProperties":false,
  "required":["apiVersion","kind","metadata","spec"],
  "properties":{"apiVersion":{"const":"atlas.mirai.dev/v1"},"kind":{"const":"Decision"},"metadata":{"$ref":"#/$defs/metadata"},"spec":{"$ref":"#/$defs/spec"}},
  "$defs":{
    "id":{"type":"string","minLength":1,"maxLength":2048,"pattern":"^[^\\u0000\\s][^\\u0000]*$"},"digest":{"type":"string","pattern":"^sha256:[a-f0-9]{64}$"},
    "metadata":{"type":"object","additionalProperties":false,"required":["id","schemaVersion"],"properties":{"id":{"$ref":"#/$defs/id"},"schemaVersion":{"const":"1"},"missionId":{"$ref":"#/$defs/id"}}},
    "scope":{"type":"object","additionalProperties":false,"required":["tenantId","organisationId","projectId","environmentId","missionId"],"properties":{"tenantId":{"$ref":"#/$defs/id"},"organisationId":{"$ref":"#/$defs/id"},"projectId":{"$ref":"#/$defs/id"},"environmentId":{"$ref":"#/$defs/id"},"missionId":{"$ref":"#/$defs/id"}}},
    "provenance":{"type":"object","additionalProperties":false,"required":["correlationId","causationId","sourceRef","inputDigest"],"properties":{"correlationId":{"$ref":"#/$defs/id"},"causationId":{"$ref":"#/$defs/id"},"sourceRef":{"$ref":"#/$defs/id"},"inputDigest":{"$ref":"#/$defs/digest"}}},
    "spec":{"type":"object","additionalProperties":false,"required":["scope","proposalId","actionClass","riskClass","autonomyLevel","policyVersion","disposition","reasonCodes","explanation","issuer","decidedAt","provenance"],"properties":{"scope":{"$ref":"#/$defs/scope"},"proposalId":{"$ref":"#/$defs/id"},"actionClass":{"$ref":"#/$defs/id"},"riskClass":{"enum":["none","low","medium","high","critical"]},"autonomyLevel":{"enum":["L0","L1","L2","L3","L4"]},"policyVersion":{"$ref":"#/$defs/id"},"disposition":{"enum":["allow","deny","require_approval","require_handoff","modify","defer","fail"]},"reasonCodes":{"type":"array","items":{"$ref":"#/$defs/id"}},"explanation":{"type":"string","minLength":1,"maxLength":10000},"issuer":{"type":"object","additionalProperties":false,"required":["type","identity"],"properties":{"type":{"enum":["system","operator"]},"identity":{"$ref":"#/$defs/id"}}},"requiredActor":{"$ref":"#/$defs/id"},"budgetReservation":{"type":"object","additionalProperties":false,"required":["amount","currency","reservationId"],"properties":{"amount":{"type":"number","minimum":0},"currency":{"type":"string","pattern":"^[A-Z]{3}$"},"reservationId":{"$ref":"#/$defs/id"}}},"evidenceRefs":{"type":"array","items":{"$ref":"#/$defs/id"}},"expiresAt":{"type":"string","format":"date-time"},"decidedAt":{"type":"string","format":"date-time"},"provenance":{"$ref":"#/$defs/provenance"}}}
  }
}
