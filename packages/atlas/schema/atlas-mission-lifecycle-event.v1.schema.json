{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.usemirai.app/atlas/mission-lifecycle-event/v1.json",
  "title": "Atlas Mission Lifecycle Event v1",
  "description": "Append-only lifecycle event for a durable Atlas Mission.",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "const": "atlas.mirai.dev/v1" },
    "kind": { "const": "MissionLifecycleEvent" },
    "metadata": { "$ref": "#/$defs/eventMetadata" },
    "spec": { "$ref": "#/$defs/eventSpec" }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\u0000]+$"
    },
    "timestamp": { "type": "string", "format": "date-time" },
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "state": {
      "type": "string",
      "enum": ["CREATED", "READY", "ACTIVE", "WAITING_EVENT", "WAITING_SCHEDULE", "WAITING_APPROVAL", "HANDED_OFF", "PAUSED", "COMPLETING", "COMPLETED", "FAILED", "CANCELLED", "EXPIRED"]
    },
    "eventType": {
      "type": "string",
      "enum": ["CREATED", "READY", "ACTIVATED", "WAITING_EVENT", "WAITING_SCHEDULE", "WAITING_APPROVAL", "HANDED_OFF", "RESUMED", "PAUSED", "COMPLETING", "COMPLETED", "FAILED", "CANCELLED", "EXPIRED"]
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tenantId", "organisationId", "projectId", "environmentId"],
      "properties": {
        "tenantId": { "$ref": "#/$defs/identifier" },
        "organisationId": { "$ref": "#/$defs/identifier" },
        "projectId": { "$ref": "#/$defs/identifier" },
        "environmentId": { "$ref": "#/$defs/identifier" }
      }
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "identity"],
      "properties": {
        "type": { "type": "string", "enum": ["system", "developer", "agent", "operator", "provider", "scheduler", "external-runtime"] },
        "identity": { "$ref": "#/$defs/identifier" }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "ref"],
      "properties": {
        "kind": { "type": "string", "enum": ["command", "observation", "provider-callback", "tool-result", "schedule", "human-control", "system"] },
        "ref": { "$ref": "#/$defs/identifier" }
      }
    },
    "eventMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["eventId", "schemaVersion"],
      "properties": {
        "eventId": { "$ref": "#/$defs/identifier" },
        "schemaVersion": { "const": "1" },
        "missionId": { "$ref": "#/$defs/identifier" }
      }
    },
    "eventSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["missionId", "scope", "eventType", "priorState", "resultingState", "stateVersion", "actor", "causationId", "correlationId", "source", "occurredAt", "recordedAt", "idempotencyKey"],
      "properties": {
        "missionId": { "$ref": "#/$defs/identifier" },
        "scope": { "$ref": "#/$defs/scope" },
        "eventType": { "$ref": "#/$defs/eventType" },
        "priorState": { "anyOf": [{ "$ref": "#/$defs/state" }, { "type": "null" }] },
        "resultingState": { "$ref": "#/$defs/state" },
        "stateVersion": { "type": "integer", "minimum": 1 },
        "actor": { "$ref": "#/$defs/actor" },
        "causationId": { "$ref": "#/$defs/identifier" },
        "correlationId": { "$ref": "#/$defs/identifier" },
        "source": { "$ref": "#/$defs/source" },
        "occurredAt": { "$ref": "#/$defs/timestamp" },
        "recordedAt": { "$ref": "#/$defs/timestamp" },
        "payloadRef": { "$ref": "#/$defs/identifier" },
        "payloadDigest": { "$ref": "#/$defs/digest" },
        "idempotencyKey": { "$ref": "#/$defs/identifier" }
      }
    }
  }
}
