{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.usemirai.app/atlas/model-route/v1.json",
  "title": "Atlas Model Route v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["requestId", "traceId", "tenantId", "environment", "mode", "providerId", "model", "messages", "requiredCapabilities", "maxOutputTokens", "budgetMinor"],
  "properties": {
    "requestId": { "type": "string", "minLength": 1 },
    "traceId": { "type": "string", "minLength": 1 },
    "tenantId": { "type": "string", "minLength": 1 },
    "environment": { "type": "string", "minLength": 1 },
    "mode": { "enum": ["local-fixture", "managed", "byok", "gateway"] },
    "providerId": { "type": "string", "minLength": 1 },
    "model": { "type": "string", "minLength": 1 },
    "messages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "content"],
        "properties": {
          "role": { "enum": ["system", "customer", "operator", "agent"] },
          "content": { "type": "string" }
        }
      }
    },
    "requiredCapabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": { "enum": ["text", "structured-output", "tool-calling", "vision", "audio", "streaming"] }
    },
    "maxOutputTokens": { "type": "integer", "minimum": 1 },
    "budgetMinor": { "type": "integer", "minimum": 0 },
    "credentialRef": { "type": "string", "pattern": "^atlas://model-references/" },
    "gatewayBaseUrl": { "type": "string", "format": "uri" },
    "fallback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "providerId", "model", "mode"],
      "properties": {
        "enabled": { "type": "boolean" },
        "providerId": { "type": "string", "minLength": 1 },
        "model": { "type": "string", "minLength": 1 },
        "mode": { "enum": ["local-fixture", "managed", "byok", "gateway"] },
        "credentialRef": { "type": "string", "pattern": "^atlas://model-references/" }
      }
    }
  }
}
