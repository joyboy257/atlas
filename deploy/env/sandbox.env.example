# Atlas Sandbox — example environment file
# ======================================
# Copy to sandbox.env and adjust as needed.
# NO real provider keys required — sandbox uses simulators.

# ── Required ────────────────────────────────────────────────────
ATLAS_SANDBOX=1
ATLAS_DATABASE_URL=postgresql://atlas:atlas-sandbox@postgres:5432/atlas
ATLAS_REDIS_URL=redis://redis:6379

# ── Channel Mode ─────────────────────────────────────────────────
# "simulator" — all channels use LOCAL_CONFORMANCE simulators
# "provider"  — use real provider connections (requires credentials below)
ATLAS_CHANNEL_MODE=simulator

# ── Model Mode ───────────────────────────────────────────────────
# "local-fixture" — no API keys needed, deterministic responses
# "managed"       — Atlas-supplied inference (requires ATLAS_API_KEY)
# "byok"          — bring your own keys (requires credentials below)
# "gateway"       — OpenAI-compatible gateway (requires ATLAS_GATEWAY_URL)
ATLAS_MODEL_MODE=local-fixture

# ── Provider Credentials (only needed for ATLAS_CHANNEL_MODE=provider) ──
# Uncomment and fill in when connecting real providers.
# ATLAS_EMAIL_PROVIDER=resend
# ATLAS_EMAIL_API_KEY=
# ATLAS_SMS_PROVIDER=twilio
# ATLAS_SMS_ACCOUNT_SID=
# ATLAS_SMS_AUTH_TOKEN=
# ATLAS_SMS_FROM_NUMBER=
# ATLAS_WHATSAPP_PROVIDER=meta
# ATLAS_WHATSAPP_ACCESS_TOKEN=
# ATLAS_WHATSAPP_PHONE_NUMBER_ID=
# ATLAS_WHATSAPP_BUSINESS_ACCOUNT_ID=

# ── Model Credentials (only needed for ATLAS_MODEL_MODE=byok) ──
# ATLAS_MODEL_PROVIDER=anthropic
# ATLAS_MODEL_API_KEY=
# ATLAS_GATEWAY_URL=

# ── Observability ────────────────────────────────────────────────
ATLAS_OTEL_ENABLED=0
ATLAS_OTEL_ENDPOINT=http://atlas-otel-collector:4318
ATLAS_LOG_LEVEL=info

# ── Security (sandbox defaults — NEVER use in production) ────────
ATLAS_JWT_SECRET=atlas-sandbox-dev-secret-do-not-use-in-prod
ATLAS_ENCRYPTION_KEY=atlas-sandbox-dev-key-32-bytes-xx
